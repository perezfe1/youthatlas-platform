# ── Supabase ──────────────────────────────────────────────────────────────────
# Public URL of your Supabase project (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (safe to expose — RLS enforces data access)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key — server-side ONLY, bypasses RLS — keep secret
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── Kit (ConvertKit) ──────────────────────────────────────────────────────────
# Kit API secret — server-side ONLY — keep secret
KIT_API_SECRET=your-kit-api-secret-here
